@model IEnumerable<HotelManagement.Models.ReservationForm>

@{
    ViewData["Title"] = "Check-in";
    var hasSearchFilter = !string.IsNullOrEmpty(ViewBag.PhoneNumber as string)
        || !string.IsNullOrEmpty(ViewBag.CustomerName as string)
        || !string.IsNullOrEmpty(ViewBag.ReservationId as string);
    var occupiedRoomIds = ViewBag.OccupiedRoomIds as List<string> ?? new List<string>();
}

<!-- Page Header -->
<div class="page-header fade-in-up">
    <h1>
        <i class="fas fa-sign-in-alt"></i>
        Quản lý Check-in
    </h1>
    <p>Danh sách các phiếu đặt phòng đã được xác nhận và chờ khách đến nhận phòng</p>
</div>

<!-- Success/Error Messages -->
