<!-- Search Form -->
<div class="card-modern fade-in-up mb-4">
    <div class="card-header-modern">
        <span><i class="fas fa-search me-2"></i>Tìm kiếm Check-in</span>
    </div>
    <div class="card-body-modern">
        <form id="searchForm" method="get" class="row g-3">
            <div class="col-md-4">
                <label for="phoneNumber" class="form-label">
                    <i class="fas fa-phone"></i> Số điện thoại
                </label>
                <input type="text" class="form-control" id="phoneNumber" name="phoneNumber"
                       placeholder="Nhập số điện thoại..." value="@ViewBag.PhoneNumber">
            </div>
            <div class="col-md-4">
                <label for="customerName" class="form-label">
                    <i class="fas fa-user"></i> Tên khách hàng
                </label>
                <input type="text" class="form-control" id="customerName" name="customerName"
                       placeholder="Nhập tên khách hàng..." value="@ViewBag.CustomerName">
            </div>
            <div class="col-md-4">
                <label for="reservationId" class="form-label">
                    <i class="fas fa-hashtag"></i> Mã phiếu đặt phòng
                </label>
                <input type="text" class="form-control" id="reservationId" name="reservationId"
                       placeholder="Nhập mã phiếu..." value="@ViewBag.ReservationId">
            </div>
            <div class="col-12">
                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-primary-modern">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary-modern">
                        <i class="fas fa-refresh"></i> Làm mới
                    </a>
                    @if (hasSearchFilter)
                    {
                        <span class="badge-modern badge-info-modern align-self-center">
                            <i class="fas fa-filter"></i> Đang lọc kết quả
                        </span>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Main Content -->
<div class="card-modern fade-in-up">
    <div class="card-header-modern d-flex justify-content-between align-items-center">
        <span><i class="fas fa-clipboard-list me-2"></i>Danh sách Chờ Check-in</span>
        <span class="badge-modern badge-info-modern">
            <i class="fas fa-list"></i> @Model.Count() phòng
        </span>
    </div>
    <div class="card-body-modern">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                @if (hasSearchFilter)
                {
                    <div class="empty-search-results">
                        <i class="fas fa-search"></i>
                        <h4 class="text-muted mb-3">Không tìm thấy kết quả</h4>
                        <p class="text-muted mb-4">Không có phiếu đặt phòng nào phù hợp với tiêu chí tìm kiếm</p>
                        <div class="mb-3">
                            <small class="text-muted">Từ khóa tìm kiếm:</small>
                            @if (!string.IsNullOrEmpty(ViewBag.PhoneNumber as string))
                            {
                                <span class="badge-modern badge-info-modern me-2">SĐT: @ViewBag.PhoneNumber</span>
                            }
                            @if (!string.IsNullOrEmpty(ViewBag.CustomerName as string))
                            {
                                <span class="badge-modern badge-info-modern me-2">Tên: @ViewBag.CustomerName</span>
                            }
                            @if (!string.IsNullOrEmpty(ViewBag.ReservationId as string))
                            {
                                <span class="badge-modern badge-info-modern me-2">Mã: @ViewBag.ReservationId</span>
                            }
                        </div>
                        <a href="@Url.Action("Index")" class="btn btn-primary-modern">
                            <i class="fas fa-refresh"></i> Xóa bộ lọc
                        </a>
                    </div>
                }
                else
                {
                <div class="stats-icon info mx-auto mb-4">
                    <i class="fas fa-inbox"></i>
                </div>
                <h4 class="text-muted mb-3">Không có phòng chờ check-in</h4>
                <p class="text-muted">Hiện tại không có đặt phòng nào đang chờ check-in</p>
                <a href="@Url.Action("Index", "Reservation")" class="btn btn-primary-modern mt-3">
                    <i class="fas fa-calendar-plus"></i> Tạo đặt phòng mới
                </a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table-modern mb-0">
                    <thead>
                        <tr>
                            <th><i class="fas fa-hashtag"></i> Mã ĐP</th>
                            <th><i class="fas fa-user"></i> Khách hàng</th>
                            <th><i class="fas fa-door-open"></i> Phòng</th>
                            <th><i class="fas fa-tag"></i> Loại phòng</th>
                            <th><i class="fas fa-sign-in-alt"></i> Check-in</th>
                            <th><i class="fas fa-sign-out-alt"></i> Check-out</th>
                            <th><i class="fas fa-money-bill"></i> Tiền cọc</th>
                            <th><i class="fas fa-cog"></i> Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var reservationId = item.ReservationFormID ?? "";
                            var isLateCheckIn = ViewBag.LateCheckInReservations != null &&
                                                ((HashSet<string>)ViewBag.LateCheckInReservations).Contains(reservationId);
                            var isSeriousLateCheckIn = ViewBag.SeriousLateCheckInReservations != null &&
                                                       ((HashSet<string>)ViewBag.SeriousLateCheckInReservations).Contains(reservationId);
                            var isExpired = ViewBag.ExpiredReservations != null &&
                                            ((HashSet<string>)ViewBag.ExpiredReservations).Contains(reservationId);
                            var isRoomOccupied = !string.IsNullOrEmpty(item.RoomID) && occupiedRoomIds.Contains(item.RoomID);
                            var roomStatus = item.Room?.RoomStatus ?? "";
                            var isRoomStatusBlocked = !string.IsNullOrEmpty(roomStatus)
                                && roomStatus != "AVAILABLE"
                                && roomStatus != "RESERVED"
                                && !isRoomOccupied;
                            var canCheckIn = !isExpired && !isRoomOccupied && !isRoomStatusBlocked;
                            var rowClass = isExpired ? "table-danger" : isSeriousLateCheckIn ? "table-warning" : isLateCheckIn ? "table-warning" : isRoomOccupied ? "table-warning" : "";
                            var checkInConfirmMessage = isSeriousLateCheckIn
                                ? $"Phiếu {reservationId} đã quá giờ nhận phòng hơn 2 giờ. Xác nhận vẫn check-in cho khách {item.Customer?.FullName}?"
                                : isLateCheckIn
                                    ? $"Phiếu {reservationId} đã trễ giờ nhận phòng. Xác nhận check-in muộn cho khách {item.Customer?.FullName}?"
                                    : $"Xác nhận check-in cho khách {item.Customer?.FullName}?";
                            
                            <tr class="@rowClass" data-reservation-id="@item.ReservationFormID">
                                <td>
                                    <strong class="text-primary">#@item.ReservationFormID</strong>
                                    @if (isExpired)
                                    {
                                        <br />
                                        <span class="badge bg-danger mt-1">
                                            <i class="fas fa-exclamation-triangle"></i> Hết hạn lưu trú
                                        </span>
                                    }
                                    else if (isSeriousLateCheckIn)
                                    {
                                        <br />
                                        <span class="badge bg-warning text-dark mt-1">
                                            <i class="fas fa-user-clock"></i> Quá giờ nhận phòng
                                        </span>
                                    }
                                    else if (isLateCheckIn)
                                    {
                                        <br />
                                        <span class="badge bg-info text-dark mt-1">
                                            <i class="fas fa-clock"></i> Trễ nhận phòng
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div>
                                        <strong>@item.Customer?.FullName</strong>
                                        <br />
                                        <small class="text-muted">
                                            <i class="fas fa-phone"></i> @item.Customer?.PhoneNumber
                                        </small>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge-modern badge-info-modern">
                                        <i class="fas fa-bed"></i> @item.RoomID
                                    </span>
                                    @if (isRoomOccupied)
                                    {
                                        <br />
                                        <span class="badge bg-warning text-dark mt-1">
                                            <i class="fas fa-user-clock"></i> Phòng đang có khách
                                        </span>
                                    }
                                    else if (isRoomStatusBlocked)
                                    {
                                        <br />
                                        <span class="badge bg-secondary mt-1">
                                            <i class="fas fa-ban"></i> @roomStatus
                                        </span>
                                    }
                                </td>
                                <td>@item.Room?.RoomCategory?.RoomCategoryName</td>
                                <td>
                                    <div>
                                        <strong>@item.CheckInDate.ToString("dd/MM/yyyy")</strong>
                                        <br />
                                        <small class="text-muted">@item.CheckInDate.ToString("HH:mm")</small>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <strong>@item.CheckOutDate.ToString("dd/MM/yyyy")</strong>
                                        <br />
                                        <small class="text-muted">@item.CheckOutDate.ToString("HH:mm")</small>
                                    </div>
                                </td>
                                <td>
                                    <strong class="text-success">@item.RoomBookingDeposit.ToString("N0")</strong>
                                    <small class="text-muted d-block">VNĐ</small>
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <form asp-action="CheckIn" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="reservationFormID" value="@item.ReservationFormID" />
                                            <button type="submit" 
                                                    class="btn btn-success-modern btn-sm js-confirm-submit" 
                                                    data-confirm-message="@checkInConfirmMessage"
                                                    title="@(isRoomOccupied ? "Chờ khách trước checkout" : isRoomStatusBlocked ? "Phòng chưa khả dụng để check-in" : isExpired ? "Phiếu đã hết hạn lưu trú" : isSeriousLateCheckIn ? "Phiếu quá giờ nhận phòng, cần xác nhận trước khi check-in" : isLateCheckIn ? "Check-in muộn" : "Check-in")"
                                                    @(!canCheckIn ? "disabled" : "")>
                                                <i class="fas fa-check"></i> Check-in
                                            </button>
                                        </form>
                                        <a asp-controller="Reservation" asp-action="Details" asp-route-id="@item.ReservationFormID" 
                                           class="btn btn-info-modern btn-sm">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-controller="ConfirmationReceipt" asp-action="PrintReservation" asp-route-reservationId="@item.ReservationFormID" 
                                           class="btn btn-warning-modern btn-sm" title="In phiếu xác nhận" target="_blank">
                                            <i class="fas fa-receipt"></i>
                                        </a>
                                        @if (isLateCheckIn || isExpired)
                                        {
                                            <form asp-action="MarkNoShow" asp-route-id="@item.ReservationFormID" method="post" class="d-inline js-confirm-form"
                                                  data-confirm-message="Đánh dấu khách không đến cho phiếu @item.ReservationFormID và giải phóng phòng nếu phù hợp?">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-secondary-modern btn-sm" title="Khách không đến">
                                                    <i class="fas fa-user-slash"></i>
                                                </button>
                                            </form>
                                        }
                                        <form asp-action="Delete" asp-route-id="@item.ReservationFormID" method="post" class="d-inline js-confirm-form" 
                                              data-confirm-message="Bạn có chắc muốn xóa phiếu đặt phòng này?">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger-modern btn-sm" title="Xóa đặt phòng">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            console.log('Check-in page loaded');

            $('.js-confirm-submit').on('click', function() {
                const message = $(this).data('confirm-message');
                return confirm(message);
            });

            $('.js-confirm-form').on('submit', function() {
                const message = $(this).data('confirm-message');
                return confirm(message);
            });
        });
    </script>
}
<!-- Quick Actions -->
<div class="row g-3 mt-3">
    <div class="col-md-6">
        <a asp-action="CheckedInList" class="btn btn-primary-modern w-100 py-3">
            <i class="fas fa-list me-2"></i>
            Xem danh sách đã check-in
        </a>
    </div>
    <div class="col-md-6">
        <a asp-controller="Reservation" asp-action="Index" class="btn btn-info-modern w-100 py-3">
            <i class="fas fa-calendar-alt me-2"></i>
            Quản lý đặt phòng
        </a>
    </div>
</div>
