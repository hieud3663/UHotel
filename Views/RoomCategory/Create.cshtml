@model HotelManagement.Models.RoomCategory

@{
    ViewData["Title"] = "Thêm loại phòng mới";
}

<!-- Page Header -->
<div class="page-header fade-in-up">
    <h1>
        <i class="fas fa-plus-circle"></i>
        Thêm loại phòng mới
    </h1>
    <p>Tạo loại phòng mới và thiết lập bảng giá</p>
</div>

<!-- Form Card -->
<div class="card-modern fade-in-up">
    <div class="card-header-modern">
        <i class="fas fa-edit me-2"></i>Thông tin Loại phòng
    </div>
    <div class="card-body-modern">
        <form id="roomCategoryCreateForm" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            
            <div class="row g-3">
                <!-- Thông tin cơ bản -->
                <div class="col-12">
                    <h5 class="border-bottom pb-2">
                        <i class="fas fa-bed me-2"></i>Thông tin cơ bản
                    </h5>
                </div>

                <div class="col-md-6">
                    <label asp-for="RoomCategoryName" class="form-label required">
                        <i class="fas fa-tag"></i> Tên loại phòng
                    </label>
                    <input asp-for="RoomCategoryName" class="form-control" 
                           placeholder="VD: Phòng Deluxe, Phòng VIP..." />
                    <span asp-validation-for="RoomCategoryName" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NumberOfBed" class="form-label required">
                        <i class="fas fa-bed"></i> Số giường
                    </label>
                    <input asp-for="NumberOfBed" type="number" min="1" max="10" class="form-control" 
                           placeholder="Số giường trong phòng" />
                    <span asp-validation-for="NumberOfBed" class="text-danger"></span>
                </div>

                <!-- Bảng giá -->
                <div class="col-12 mt-4">
                    <h5 class="border-bottom pb-2">
                        <i class="fas fa-money-bill-wave me-2"></i>Bảng giá (VNĐ)
                    </h5>
                    <p class="text-muted small">
                        <i class="fas fa-info-circle"></i> Bạn có thể nhập một hoặc cả hai mức giá. Để trống nếu không cung cấp hình thức thuê đó.
                    </p>
                </div>

                <div class="col-md-6">
                    <label for="priceHour" class="form-label">
                        <i class="fas fa-clock"></i> Giá theo giờ
                    </label>
                    <div class="input-group">
                        <input type="number" name="priceHour" id="priceHour" class="form-control" 
                               min="0" step="10000" placeholder="VD: 150000" />
                        <span class="input-group-text">VNĐ/giờ</span>
                    </div>
                    <span id="priceHourError" class="text-danger d-block mt-1"></span>
                    <small class="text-muted">Áp dụng cho thuê phòng theo giờ</small>
                </div>

                <div class="col-md-6">
                    <label for="priceDay" class="form-label">
                        <i class="fas fa-calendar-day"></i> Giá theo ngày
                    </label>
                    <div class="input-group">
                        <input type="number" name="priceDay" id="priceDay" class="form-control" 
                               min="0" step="10000" placeholder="VD: 800000" />
                        <span class="input-group-text">VNĐ/ngày</span>
                    </div>
                    <span id="priceDayError" class="text-danger d-block mt-1"></span>
                    <small class="text-muted">Áp dụng cho thuê phòng theo ngày/đêm</small>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button id="saveRoomCategoryButton" type="submit" class="btn btn-primary-modern">
                    <i class="fas fa-save"></i> Lưu loại phòng
                </button>
                <a asp-action="Index" class="btn btn-secondary-modern">
                    <i class="fas fa-times"></i> Hủy
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        function getRoomCategoryCreatePayload() {
            return {
                roomCategoryName: $('[name="RoomCategoryName"]').val(),
                numberOfBed: $('[name="NumberOfBed"]').val(),
                priceHour: $('#priceHour').val(),
                priceDay: $('#priceDay').val()
            };
        }

        function clearPriceValidationErrors() {
            $('#priceHourError, #priceDayError').text('');
        }

        function getPriceInputError(input) {
            const label = input.id === 'priceHour' ? 'Giá theo giờ' : 'Giá theo ngày';

            if (!input.validity.valid) {
                if (input.validity.rangeUnderflow) {
                    return label + ' không được nhỏ hơn 0.';
                }

                if (input.validity.stepMismatch) {
                    return label + ' phải là bội số của 10.000 VNĐ.';
                }

                if (input.validity.badInput) {
                    return label + ' phải là số hợp lệ.';
                }

                return input.validationMessage;
            }

            return '';
        }

        function displayPriceValidationErrors() {
            clearPriceValidationErrors();

            const priceHourInput = document.getElementById('priceHour');
            const priceDayInput = document.getElementById('priceDay');
            const priceHourError = getPriceInputError(priceHourInput);
            const priceDayError = getPriceInputError(priceDayInput);

            $('#priceHourError').text(priceHourError);
            $('#priceDayError').text(priceDayError);

            return !priceHourError && !priceDayError;
        }

        $('#saveRoomCategoryButton').on('click', function () {
            const form = $('#roomCategoryCreateForm');
            const isJqueryValid = typeof form.valid === 'function' ? form.valid() : 'jquery-validate-unavailable';
            const validator = form.data('validator');
            const validationErrors = validator
                ? validator.errorList.map(function (item) {
                    return {
                        name: item.element.name,
                        value: item.element.value,
                        message: item.message,
                        validity: item.element.validity
                    };
                })
                : [];

            console.info('[RoomCategory/Create] Bấm nút Lưu', {
                payload: getRoomCategoryCreatePayload(),
                jqueryValid: isJqueryValid,
                validationErrors: validationErrors
            });

            displayPriceValidationErrors();
        });

        $('#priceHour, #priceDay').on('input change invalid', function () {
            displayPriceValidationErrors();
        });

        // Validation: Ít nhất một trong hai giá phải được nhập
        $('#roomCategoryCreateForm').submit(function(e) {
            const priceHour = parseFloat($('#priceHour').val()) || 0;
            const priceDay = parseFloat($('#priceDay').val()) || 0;

            console.info('[RoomCategory/Create] Submit form', {
                payload: getRoomCategoryCreatePayload(),
                parsedPriceHour: priceHour,
                parsedPriceDay: priceDay
            });

            if (!displayPriceValidationErrors()) {
                console.warn('[RoomCategory/Create] Chặn submit: input giá không hợp lệ theo HTML validation');
                return false;
            }
            
            if (priceHour <= 0 && priceDay <= 0) {
                e.preventDefault();
                console.warn('[RoomCategory/Create] Chặn submit: chưa nhập giá theo giờ hoặc giá theo ngày');
                $('#priceHourError').text('Nhập giá theo giờ hoặc giá theo ngày.');
                $('#priceDayError').text('Nhập giá theo ngày hoặc giá theo giờ.');
                return false;
            }

            console.info('[RoomCategory/Create] Cho phép submit lên server');
        });
    </script>
}
