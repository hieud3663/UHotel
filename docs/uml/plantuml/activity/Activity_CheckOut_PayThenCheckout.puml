@startuml Activity_CheckOut_PayThenCheckout
skinparam shadowing false
title Sơ đồ hoạt động - Thanh toán trước, trả phòng sau

start
:Nhân viên mở chi tiết trả phòng;
:Tính chi phí cần thanh toán;
:Khách chọn thanh toán trước;
:Gọi thủ tục tạo hóa đơn thanh toán trước;
if (Tạo hóa đơn thanh toán trước thành công?) then (Có)
  :Cập nhật hóa đơn thành đã thanh toán;
  :Giữ phòng và phiếu lưu trú cho đến khi trả phòng thực tế;
  :In hóa đơn hoặc biên nhận thanh toán;
else (Không)
  :Hiển thị lỗi thanh toán trước;
  stop
endif

:Đến thời điểm khách trả phòng thực tế;
:Nhân viên chọn trả phòng thực tế;
:Gọi thủ tục trả phòng sau thanh toán trước;
if (Trả phòng thực tế thành công?) then (Có)
  :Tạo lịch sử trả phòng;
  :Cập nhật phòng sang còn trống;
  :Tạo phiếu xác nhận trả phòng nếu cần;
else (Không)
  :Hiển thị lỗi trạng thái;
endif
stop
@enduml
