@startuml UseCase_CheckOutPayment
left to right direction
skinparam shadowing false
title Sơ đồ ca sử dụng chi tiết - Trả phòng và thanh toán

actor "Khách hàng" as Customer
actor "Nhân viên/Lễ tân" as Staff
actor "Cổng thanh toán" as Gateway

rectangle "Trả phòng và thanh toán" {
  usecase "Xem chi tiết chi phí" as UC_Details
  usecase "Tính tiền phòng" as UC_RoomFee
  usecase "Tính tiền dịch vụ" as UC_ServiceFee
  usecase "Tính thuế, cọc và số tiền còn lại" as UC_Total
  usecase "Đổi thuê giờ sang thuê ngày" as UC_Convert
  usecase "Trả phòng trước, thanh toán sau" as UC_CheckoutThenPay
  usecase "Thanh toán trước, trả phòng sau" as UC_PayThenCheckout
  usecase "Xác nhận thanh toán" as UC_Confirm
  usecase "Xác nhận chuyển khoản qua cổng thanh toán" as UC_Webhook
  usecase "Trả phòng thực tế sau thanh toán trước" as UC_ActualCheckout
  usecase "Tạo hóa đơn" as UC_Invoice
  usecase "Tạo lịch sử trả phòng" as UC_History
  usecase "Giải phóng phòng" as UC_FreeRoom
}

Customer --> UC_Details
Customer --> UC_Confirm
Staff --> UC_Details
Staff --> UC_Convert
Staff --> UC_CheckoutThenPay
Staff --> UC_PayThenCheckout
Staff --> UC_ActualCheckout
Gateway --> UC_Webhook

UC_Details ..> UC_RoomFee : <<include>>
UC_Details ..> UC_ServiceFee : <<include>>
UC_Details ..> UC_Total : <<include>>
UC_CheckoutThenPay ..> UC_Invoice : <<include>>
UC_CheckoutThenPay ..> UC_History : <<include>>
UC_CheckoutThenPay ..> UC_FreeRoom : <<include>>
UC_CheckoutThenPay ..> UC_Confirm : <<include>>
UC_PayThenCheckout ..> UC_Invoice : <<include>>
UC_PayThenCheckout ..> UC_Confirm : <<include>>
UC_ActualCheckout ..> UC_History : <<include>>
UC_ActualCheckout ..> UC_FreeRoom : <<include>>
UC_Webhook ..> UC_Confirm : <<extend>>
UC_Convert ..> UC_Details : <<extend>>
@enduml
